<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of Chapterly goes into a cloud backup or a phone-to-phone
     transfer: the library, the pairing code and the book server token stay
     on this phone. Your own backups (Settings > Backup) are how a library
     moves. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
